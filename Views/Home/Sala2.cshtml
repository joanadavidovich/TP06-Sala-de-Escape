@{
    ViewData["Title"] = "Sala 2 - Las Imágenes Borrosas";
}

<div class="sala2-container">
    <!-- HEADER -->
    <div class="sala2-header">
        <h1>📸 SALA 2 — LAS IMÁGENES BORROSAS 📸</h1>
        <p>Objetivo: Descubrir el país. Están en Europa, pero ¿dónde exactamente?</p>

        <div class="progress-tracker">
            <div class="consigna-progress" data-consigna="1">
                <span class="step-number">1</span>
                <span class="step-name">5 Fotos</span>
            </div>
            <div class="consigna-progress" data-consigna="2">
                <span class="step-number">2</span>
                <span class="step-name">Análisis</span>
            </div>
            <div class="consigna-progress" data-consigna="3">
                <span class="step-number">3</span>
                <span class="step-name">País</span>
            </div>
        </div>
    </div>

    <!-- CONSIGNA 1: LAS 5 FOTOGRAFÍAS BORROSAS -->
    <div class="consigna-container active" id="consigna1">
        <div class="consigna-titulo">
            <h2>🧩 CONSIGNA 1 — ORDENAR LAS FOTOS</h2>
            <p>Las cámaras del aeropuerto están dañadas. Primero hay que reconstruir la secuencia de grabación.</p>
            <p>Cada imagen tiene un dato de tiempo escondido, pero los números aparecen muy borrosos y algunos no se ven completos.</p>
            <p class="consigna-warning">🔒 MEJORAR IMÁGENES está bloqueado hasta restaurar la secuencia correcta.</p>
        </div>

        <div class="desafio-secuencia">
            <div class="foto-secuencia-panel">
                <h3>Fotos grabadas</h3>
                <div class="foto-secuencia-grid">
                    <div class="foto-secuencia-item" data-secuencia="1">
                        <div class="foto-timestamp">22:41</div>
                        <img src="/images/sala2/bandera.jpg" alt="Zona exterior" />
                        <span>Zona exterior</span>
                    </div>
                    <div class="foto-secuencia-item" data-secuencia="2">
                        <div class="foto-timestamp">22:53</div>
                        <img src="/images/sala2/cartel.jpg" alt="Señal" />
                        <span>Señal</span>
                    </div>
                    <div class="foto-secuencia-item" data-secuencia="3">
                        <div class="foto-timestamp">23:07</div>
                        <img src="/images/sala2/edificio.jpg" alt="Parte del edificio" />
                        <span>Parte del edificio</span>
                    </div>
                    <div class="foto-secuencia-item" data-secuencia="4">
                        <div class="foto-timestamp">23:12</div>
                        <img src="/images/sala2/señal.jpg" alt="Entrada" />
                        <span>Entrada</span>
                    </div>
                    <div class="foto-secuencia-item" data-secuencia="5">
                        <div class="foto-timestamp">23:19</div>
                        <img src="/images/sala2/paisaje.jpg" alt="Zona de la terminal" />
                        <span>Zona de la terminal</span>
                    </div>
                </div>
            </div>

            <div class="orden-secuencia-panel">
                <h3>Secuencia correcta</h3>
                <div class="orden-secuencia-dropzone" id="ordenSecuenciaDropzone">
                    <div class="orden-secuencia-slot" data-slot="1">1</div>
                    <div class="orden-secuencia-slot" data-slot="2">2</div>
                    <div class="orden-secuencia-slot" data-slot="3">3</div>
                    <div class="orden-secuencia-slot" data-slot="4">4</div>
                    <div class="orden-secuencia-slot" data-slot="5">5</div>
                </div>

                <div class="codigo-secuencia">
                    <label for="codigoSecuencia">Código de desbloqueo</label>
                    <input id="codigoSecuencia" type="text" placeholder="4 - 1 - 5 - 2 - 3" maxlength="15" />
                </div>

                <div class="consigna-actions">
                    <button class="btn btn-primary" id="verificarConsigna1">Comprobar secuencia</button>
                    <button class="btn btn-secondary" id="mejorarImagenes" disabled>🔒 MEJORAR IMÁGENES</button>
                </div>
            </div>
        </div>
    </div>

    <div class="mapamundi-section-container">
        <div class="mapamundi-section">
            <div class="mapamundi-header">
                <h2>📍 Ubicación en el Mapamundi</h2>
                <p>Observa la ubicación geográfica de Europa y sus pistas</p>
            </div>

            <div class="mapamundi-content">
                <div class="mapamundi-placeholder" id="mapamundiPlaceholder">
                    <div class="mapamundi-icon">🗺️</div>
                    <div class="mapamundi-label">Mapa de Europa</div>
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d12200837.154720126!2d7.0827299622897435!3d51.11224279096671!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x46ed8886cfadda85%3A0x72ef99e6b3fcf079!2sEuropa!5e0!3m2!1ses!2sar!4v1788868634933!5m2!1ses!2sar" width="600" height="450" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
            </div>
                </div>
            <div class="mapamundi-pistas">
                <h4>💡 Pistas del continente:</h4>
                <ul>
                    <li>Es un continente europeo</li>
                    <li>Tiene un aeropuerto internacional importante</li>
                    <li>Las 5 fotografías contienen claves sobre su identidad</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- CONSIGNA 2: ANÁLISIS DE PISTAS -->
    <div class="consigna-container" id="consigna2">
        <div class="consigna-titulo">
            <h2>🔍 CONSIGNA 2 — Análisis de Pistas</h2>
            <p>Relaciona los elementos de las 5 fotografías para encontrar el país.</p>
        </div>

        <div class="analisis-container">
            <div class="pistas-list" id="pistasList"></div>
            <button class="btn btn-primary" id="verificarConsigna2">Siguiente Consigna</button>
        </div>
    </div>

    <!-- CONSIGNA 3: IDENTIFICAR EL PAÍS -->
    <div class="consigna-container" id="consigna3">
        <div class="consigna-titulo">
            <h2>🎯 CONSIGNA 3 — ¿En qué país estamos?</h2>
            <p>Basándote en todas las pistas, identifica el país donde se encuentra el aeropuerto.</p>
        </div>

        <div class="paises-opciones">
            <div class="paises-grid" id="paisesGrid"></div>
            <button class="btn btn-primary" id="verificarConsigna3">Verificar País</button>
        </div>
    </div>

    <!-- NAVEGACIÓN -->
    <div class="sala-navigation">
        <a href="@Url.Action("Sala1")" class="btn btn-outline">← Volver a Sala 1</a>
        <a href="@Url.Action("Index")" class="btn btn-outline">Ir al Inicio</a>
    </div>
</div>

