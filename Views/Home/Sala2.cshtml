@{
    ViewData["Title"] = "Sala 2 - Las Imágenes Borrosas";
}

<div class="sala2-container">
    <!-- HEADER -->
    <div class="sala2-header">
        <h1>📸 SALA 2 — LAS IMÁGENES BORROSAS 📸</h1>
        <p>Objetivo: Descubrir el país. Están en Europa, pero ¿dónde exactamente?</p>
        
        <div class="progress-tracker">
            <div class="consigna-progress" data-consigna="1">
                <span class="step-number">1</span>
                <span class="step-name">5 Fotos</span>
            </div>
            <div class="consigna-progress" data-consigna="2">
                <span class="step-number">2</span>
                <span class="step-name">Análisis</span>
            </div>
            <div class="consigna-progress" data-consigna="3">
                <span class="step-number">3</span>
                <span class="step-name">País</span>
            </div>
        </div>
    </div>

    <!-- CONSIGNA 1: LAS 5 FOTOGRAFÍAS BORROSAS -->
    <div class="consigna-container" id="consigna1" style="display: block;">
        <div class="consigna-titulo">
            <h2>🧩 CONSIGNA 1 — Las Fotografías Recuperadas</h2>
            <p>El sistema recuperó 5 fotografías tomadas dentro y alrededor del aeropuerto, pero están muy borrosas.</p>
            <p>Ninguna alcanza para identificar el país por sí sola. Tendrás que observar las 5 y relacionarlas.</p>
            <p style="color: #e74c3c; font-weight: bold; margin-top: 10px;">⚠️ Analiza cuidadosamente cada imagen. Las pistas están en todos lados.</p>
        </div>

        <!-- GRID DE 5 FOTOGRAFÍAS -->
        <div class="fotografias-grid">
            <div class="foto-slot" id="fotoSlot1">
                <div class="foto-placeholder">
                    <div class="foto-icon">🚩</div>
                    <div class="foto-label">Bandera</div>
                    <div class="foto-descripcion">Una parte de una bandera nacional</div>
                </div>
                <img class="foto-borrosa" id="fotoBandera" src="/images/sala2/bandera.jpg" alt="Bandera" style="display: none; max-width: 100%; border-radius: 8px;">
            </div>

            <div class="foto-slot" id="fotoSlot2">
                <div class="foto-placeholder">
                    <div class="foto-icon">📝</div>
                    <div class="foto-label">Cartel</div>
                    <div class="foto-descripcion">Un cartel con información</div>
                </div>
                <img class="foto-borrosa" id="fotoCartel" src="/images/sala2/cartel.jpg" alt="Cartel" style="display: none; max-width: 100%; border-radius: 8px;">
            </div>

            <div class="foto-slot" id="fotoSlot3">
                <div class="foto-placeholder">
                    <div class="foto-icon">⚠️</div>
                    <div class="foto-label">Señal</div>
                    <div class="foto-descripcion">Una señal de información</div>
                </div>
                <img class="foto-borrosa" id="fotoSeñal" src="/images/sala2/señal.jpg" alt="Señal" style="display: none; max-width: 100%; border-radius: 8px;">
            </div>

            <div class="foto-slot" id="fotoSlot4">
                <div class="foto-placeholder">
                    <div class="foto-icon">🏛️</div>
                    <div class="foto-label">Edificio</div>
                    <div class="foto-descripcion">Parte de un edificio emblemático</div>
                </div>
                <img class="foto-borrosa" id="fotoEdificio" src="/images/sala2/edificio.jpg" alt="Edificio" style="display: none; max-width: 100%; border-radius: 8px;">
            </div>

            <div class="foto-slot" id="fotoSlot5">
                <div class="foto-placeholder">
                    <div class="foto-icon">🌄</div>
                    <div class="foto-label">Paisaje</div>
                    <div class="foto-descripcion">Un paisaje característico</div>
                </div>
                <img class="foto-borrosa" id="fotoPaisaje" src="/images/sala2/paisaje.jpg" alt="Paisaje" style="display: none; max-width: 100%; border-radius: 8px;">
            </div>
        </div>

        <!-- BOTONES DE ACCIONES -->
        <div class="consigna-actions">
            <button class="btn btn-primary" id="verificarConsigna1">Verificar Análisis</button>
            <button class="btn btn-secondary" id="mostrarPistas">Mostrar Pistas</button>
        </div>
    </div>

    <!-- SECCIÓN ESPECIAL: MAPAMUNDI -->
    <div class="mapamundi-section-container">
        <div class="mapamundi-section">
            <div class="mapamundi-header">
                <h2>📍 Ubicación en el Mapamundi</h2>
                <p>Observa la ubicación geográfica de Europa y sus pistas</p>
            </div>

            <div class="mapamundi-content">
                <div class="mapamundi-placeholder" id="mapamundiPlaceholder">
                    <div class="mapamundi-icon">🗺️</div>
                    <div class="mapamundi-label">Mapa de Europa</div>
                    <p>Aquí irá el mapa interactivo</p>
                </div>
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d12200837.154720126!2d7.0827299622897435!3d51.11224279096671!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x46ed8886cfadda85%3A0x72ef99e6b3fcf079!2sEuropa!5e0!3m2!1ses!2sar!4v1788868634933!5m2!1ses!2sar" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
            </div>

            <div class="mapamundi-pistas">
                <h4>💡 Pistas del continente:</h4>
                <ul>
                    <li>Es un continente europeo</li>
                    <li>Tiene un aeropuerto internacional importante</li>
                    <li>Las 5 fotografías contienen claves sobre su identidad</li>
                </ul>
            </div>
        </div>

    <!-- CONSIGNA 2: ANÁLISIS DE PISTAS -->
    <div class="consigna-container" id="consigna2" style="display: none;">
        <div class="consigna-titulo">
            <h2>🔍 CONSIGNA 2 — Análisis de Pistas</h2>
            <p>Relaciona los elementos de las 5 fotografías para encontrar el país.</p>
        </div>

        <div class="analisis-container">
            <div class="pistas-list" id="pistasList">
                <!-- Las pistas se cargarán desde JavaScript -->
            </div>
            <button class="btn btn-primary" id="verificarConsigna2">Siguiente Consigna</button>
        </div>
    </div>

    <!-- CONSIGNA 3: IDENTIFICAR EL PAÍS -->
    <div class="consigna-container" id="consigna3" style="display: none;">
        <div class="consigna-titulo">
            <h2>🎯 CONSIGNA 3 — ¿En qué país estamos?</h2>
            <p>Basándote en todas las pistas, identifica el país donde se encuentra el aeropuerto.</p>
        </div>

        <div class="paises-opciones">
            <div class="paises-grid" id="paisesGrid">
                <!-- Las opciones se cargarán desde JavaScript -->
            </div>
            <button class="btn btn-primary" id="verificarConsigna3">Verificar País</button>
        </div>
    </div>

    <!-- NAVEGACIÓN -->
    <div class="sala-navigation">
        <a href="@Url.Action("Sala1")" class="btn btn-outline">← Volver a Sala 1</a>
        <a href="@Url.Action("Index")" class="btn btn-outline">Ir al Inicio</a>
    </div>
</div>

<!-- ESTILOS PARA SALA 2 -->
<style>
.sala2-container {
    max-width: 1200px;
    margin: 20px auto;
    padding: 20px;
    background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    border-radius: 15px;
    min-height: 100vh;
}

.sala2-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 30px;
    border-radius: 15px;
    margin-bottom: 30px;
    text-align: center;
}

.sala2-header h1 {
    font-size: 2.5em;
    margin: 0;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
}

.sala2-header p {
    font-size: 1.1em;
    margin-top: 10px;
    opacity: 0.95;
}

.progress-tracker {
    display: flex;
    justify-content: center;
    gap: 40px;
    margin-top: 20px;
    flex-wrap: wrap;
}

.consigna-progress {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.1);
    padding: 10px 20px;
    border-radius: 25px;
    cursor: pointer;
    transition: all 0.3s ease;
}

.consigna-progress:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: scale(1.05);
}

.step-number {
    background: white;
    color: #667eea;
    width: 35px;
    height: 35px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 1.1em;
}

.step-name {
    color: white;
    font-weight: 500;
}

.consigna-container {
    background: white;
    padding: 30px;
    border-radius: 15px;
    margin-bottom: 30px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
}

.consigna-titulo {
    margin-bottom: 25px;
    border-bottom: 3px solid #667eea;
    padding-bottom: 20px;
}

.consigna-titulo h2 {
    color: #667eea;
    font-size: 1.8em;
    margin: 0;
}

.consigna-titulo p {
    color: #555;
    font-size: 1em;
    margin: 10px 0 0 0;
    line-height: 1.6;
}

.fotografias-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    margin-bottom: 40px;
}

.mapamundi-section-container {
    background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    padding: 30px;
    border-radius: 15px;
    margin: 30px auto;
    max-width: 1200px;
}

.foto-slot {
    background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
    border: 3px dashed #667eea;
    border-radius: 12px;
    padding: 20px;
    text-align: center;
    min-height: 280px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: all 0.3s ease;
}

.foto-slot:hover {
    border-color: #764ba2;
    background: linear-gradient(135deg, #f9f9f9 0%, #f0f0f0 100%);
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.2);
}

.foto-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
}

.foto-icon {
    font-size: 3em;
}

.foto-label {
    font-weight: bold;
    color: #667eea;
    font-size: 1.1em;
}

.foto-descripcion {
    color: #666;
    font-size: 0.9em;
    line-height: 1.4;
}

.foto-borrosa {
    width: 100%;
    height: 100%;
    filter: blur(8px);
    object-fit: cover;
}

.mapamundi-section {
    background: linear-gradient(135deg, #fff5e1 0%, #ffe4cc 100%);
    padding: 30px;
    border-radius: 12px;
    border-left: 5px solid #ff9800;
}

.mapamundi-header {
    margin-bottom: 30px;
    text-align: center;
}

.mapamundi-header h2 {
    color: #ff9800;
    margin: 0;
    font-size: 1.8em;
}

.mapamundi-header p {
    color: #666;
    margin: 10px 0 0 0;
}

.mapamundi-content {
    background: white;
    padding: 20px;
    border-radius: 12px;
    margin-bottom: 20px;
    border: 3px dashed #ff9800;
    min-height: 450px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.mapamundi-placeholder {
    background: #fafafa;
    border: 3px dashed #ff9800;
    border-radius: 12px;
    padding: 60px 20px;
    text-align: center;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 15px;
    transition: all 0.3s ease;
}

.mapamundi-placeholder:hover {
    background: #fffbf0;
    box-shadow: 0 4px 12px rgba(255, 152, 0, 0.2);
}

.mapamundi-icon {
    font-size: 5em;
}

.mapamundi-label {
    font-weight: bold;
    color: #ff9800;
    font-size: 1.4em;
}

.mapamundi-img {
    width: 100%;
    border-radius: 8px;
}

.mapamundi-pistas {
    background: linear-gradient(135deg, #e3f2fd 0%, #f3e5f5 100%);
    padding: 20px;
    border-radius: 12px;
    border-left: 4px solid #ff9800;
}

.mapamundi-pistas h4 {
    color: #ff9800;
    margin: 0 0 15px 0;
    font-size: 1.1em;
}

.mapamundi-pistas ul {
    list-style: none;
    padding: 0;
    margin: 0;
}

.mapamundi-pistas li {
    color: #666;
    padding: 8px 0;
    margin-left: 20px;
}

.mapamundi-pistas li:before {
    content: "▶ ";
    color: #ff9800;
    font-weight: bold;
    margin-left: -20px;
    margin-right: 10px;
}

.consigna-actions {
    display: flex;
    gap: 15px;
    justify-content: center;
    margin-top: 30px;
    flex-wrap: wrap;
}

.btn {
    padding: 12px 30px;
    font-size: 1em;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-weight: bold;
    transition: all 0.3s ease;
}

.btn-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
}

.btn-secondary {
    background: #3498db;
    color: white;
}

.btn-secondary:hover {
    background: #2980b9;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(52, 152, 219, 0.4);
}

.btn-outline {
    background: transparent;
    color: #667eea;
    border: 2px solid #667eea;
}

.btn-outline:hover {
    background: #667eea;
    color: white;
}

.analisis-container,
.paises-opciones {
    padding: 20px 0;
}

.pistas-list {
    background: #f9f9f9;
    padding: 20px;
    border-radius: 8px;
    margin-bottom: 20px;
}

.paises-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 15px;
    margin-bottom: 20px;
}

.sala-navigation {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 40px;
    flex-wrap: wrap;
}

@@media (max-width: 768px) {
    .sala2-header h1 {
        font-size: 1.8em;
    }

    .fotografias-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .progress-tracker {
        gap: 15px;
    }

    .consigna-container {
        padding: 20px;
    }
}

@@media (max-width: 480px) {
    .sala2-container {
        padding: 10px;
    }

    .sala2-header {
        padding: 20px;
    }

    .sala2-header h1 {
        font-size: 1.5em;
    }

    .fotografias-grid {
        grid-template-columns: 1fr;
    }

    .consigna-actions {
        flex-direction: column;
    }

    .btn {
        width: 100%;
    }
}
</style>
