@{
    ViewData["Title"] = "Crear perfil";
}

<main class="auth-page">
    <section class="auth-card" aria-labelledby="registerTitle">
        <div class="auth-card-mark">✦</div>
        <p class="auth-eyebrow">DESTINO DESCONOCIDO · REGISTRO</p>
        <h1>Prepará tu credencial</h1>
        <p class="auth-lead">Creá el perfil que identificará tu partida. Cuando vuelvas, la misión continuará desde la misma sala y con el tiempo restante.</p>

        @if (ViewBag.Error is string error)
        {
            <div class="auth-error" role="alert">@error</div>
        }

        <form class="auth-form" method="post" asp-action="Register" asp-controller="Home">
            <label for="nombre">Nombre del perfil</label>
            <input id="nombre" type="text" name="nombre" autocomplete="name" required autofocus placeholder="Ej. Ana García" />
            <label for="email">Email</label>
            <input id="email" type="email" name="email" autocomplete="email" required placeholder="ana@correo.com" />
            <label for="password">Contraseña</label>
            <input id="password" type="password" name="password" autocomplete="new-password" minlength="8" required placeholder="Mínimo 8 caracteres" />
            <label for="confirmPassword">Repetir contraseña</label>
            <input id="confirmPassword" type="password" name="confirmPassword" autocomplete="new-password" minlength="8" required placeholder="Repetí tu contraseña" />
            <button class="btn-auth-submit" type="submit">Crear perfil y comenzar <span>→</span></button>
        </form>

        <p class="auth-switch">¿Ya tenés un perfil? <a href="@Url.Action("Login")">Iniciar sesión</a></p>
        <a class="auth-back" href="@Url.Action("Index")">← Volver a la Home</a>
    </section>
</main>
