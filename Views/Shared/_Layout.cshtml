<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TP06_Sala_de_Escape</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TP06_Sala_de_Escape.styles.css" asp-append-version="true" />
</head>
<body data-partida-started-at="@ViewBag.PartidaFechaInicio" data-tiempo-restante="@ViewBag.TiempoRestanteSegundos" data-nivel-actual="@ViewBag.NivelActual">
    <header>
        <div class="room-timer-bar">
            <div class="container">
                <div class="timer-wrapper">
                    <span>⏱️ Tiempo restante</span>
                    <strong id="roomTimer">30:00</strong>
                </div>
            </div>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
